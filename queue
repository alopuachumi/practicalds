#include <stdio.h>
#define MAX 5

int queue[MAX] = {10, 20, 30};
int front = 0, rear = 2;

void enqueue()
{
    int x;
    if(rear == MAX-1)
        printf("Queue Overflow");
    else
    {
        printf("Enter value: ");
        scanf("%d", &x);
        queue[++rear] = x;
    }
}

void dequeue()
{
    if(front > rear)
        printf("Queue Underflow");
    else
        printf("Deleted: %d", queue[front++]);
}

void display()
{
    int i;
    if(front > rear)
        printf("Queue Empty");
    else
        for(i = front; i <= rear; i++)
            printf("%d\n", queue[i]);
}

int main()
{
    int ch;
    do
    {
        printf("\n1.Enqueue 2.Dequeue 3.Display 4.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch(ch)
        {
            case 1: enqueue(); break;
            case 2: dequeue(); break;
            case 3: display(); break;
            case 4: break;
            default: printf("Invalid Choice");
        }
    }while(ch != 4);

    return 0;
}
