#include <stdio.h>
#define MAX 5

int stack[MAX] = {10, 20, 30};
int top = 2;

void push()
{
    int x;
    if(top == MAX-1)
        printf("Stack Overflow");
    else
    {
        printf("Enter value: ");
        scanf("%d", &x);
        stack[++top] = x;
    }
}

void pop()
{
    if(top == -1)
        printf("Stack Underflow");
    else
        printf("Deleted: %d", stack[top--]);
}

void display()
{
    int i;
    if(top == -1)
        printf("Stack Empty");
    else
        for(i = top; i >= 0; i--)
            printf("%d\n", stack[i]);
}

int main()
{
    int ch;
    do
    {
        printf("\n1.Push 2.Pop 3.Display 4.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch(ch)
        {
            case 1: push(); break;
            case 2: pop(); break;
            case 3: display(); break;
            case 4: break;
            default: printf("Invalid Choice");
        }
    }while(ch != 4);

    return 0;
}
