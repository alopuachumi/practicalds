#include <stdio.h>

int main() {
    int arr[50], n, key;
    int low, high, mid, found = 0;

    printf("Enter number of elements (max 50): ");
    scanf("%d", &n);

    printf("Enter the elements in ascending (sorted) order.\n");
    for (int i = 0; i < n; i++) {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;
        if (arr[mid] == key) {
            printf("Element found at position %d (index %d)\n", mid + 1, mid);
            found = 1;
            break;
        } else if (arr[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    if (!found)
        printf("Element not found.\n");

    return 0;
}
